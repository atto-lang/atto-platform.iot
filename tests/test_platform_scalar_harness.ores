// Pure Oreslang scalar reference models; these do not call platform native APIs.
import class TestCase, TestSuite, TestOptions, TestOutcome, RunSummary from "ores.std/testing";
import fnc expect_true, run_suite, require_success from "ores.std/testing";

fnc frame_valid(int version, int kind, int bytes, int available): bool {
  return version == 1 && kind >= 1 && kind <= 3 && bytes >= 0
    && bytes <= 1024 && available == bytes;
}

fnc frame_exact_length_boundary(): TestOutcome {
  return expect_true(frame_valid(1, 1, 1024, 1024) && frame_valid(1, 3, 0, 0), "frame_exact_length_boundary reference assertion failed");
}
fnc frame_trailing_and_truncated_rejected(): TestOutcome {
  return expect_true(!frame_valid(1, 2, 5, 4) && !frame_valid(1, 2, 5, 6), "frame_trailing_and_truncated_rejected reference assertion failed");
}
fnc frame_bad_version_and_kind_rejected(): TestOutcome {
  return expect_true(!frame_valid(2, 1, 8, 8) && !frame_valid(1, 4, 8, 8), "frame_bad_version_and_kind_rejected reference assertion failed");
}
pub routine main(): void {
  val TestSuite suite = new TestSuite("iot-scalar-reference", arr[
    new TestCase("frame_exact_length_boundary", frame_exact_length_boundary, false, ""),
    new TestCase("frame_trailing_and_truncated_rejected", frame_trailing_and_truncated_rejected, false, ""),
    new TestCase("frame_bad_version_and_kind_rejected", frame_bad_version_and_kind_rejected, false, "")
  ]);
  val TestOptions options = new TestOptions("", false, true);
  val RunSummary summary = run_suite(rt borrow suite, rt borrow options);
  require_success(rt borrow summary);
  return;
}
